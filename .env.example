# ==============================================================================
# RESTAURANTOS ENVIRONMENT CONFIGURATION (.env.example)
# Production-ready configuration for Indian Restaurant SaaS & Multi-Branch POS
# ==============================================================================

# Application & Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-this-to-a-super-secure-random-64-character-secret-in-production

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL (Production Docker / Cloud Managed DB)
DATABASE_URL="postgresql://restaurantos_user:SecurePassword123@postgres:5432/restaurantos_prod?schema=public"

# SQLite (Local Embedded Development Fallback)
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# REDIS (SOCKET.IO KDS CLUSTER & CACHING)
# ------------------------------------------------------------------------------
REDIS_URL="redis://:RedisSecurePassword@redis:6379"

# ------------------------------------------------------------------------------
# INDIAN GST & RESTAURANT TAXATION DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_BRANCH_CODE=IND
DEFAULT_CGST_RATE=2.5
DEFAULT_SGST_RATE=2.5
DEFAULT_IGST_RATE=5.0
DEFAULT_TAX_INCLUSIVE=false
RESTAURANT_LEGAL_ENTITY="Bawarchi Royale Hospitality Private Limited"
DEFAULT_GSTIN="29AABCU9603R1ZM"
DEFAULT_FSSAI_LICENSE="11223344000123"

# ------------------------------------------------------------------------------
# UPI PAYMENTS & SOUNDBOX INTEGRATION
# ------------------------------------------------------------------------------
UPI_PAYEE_VPA="bawarchiroyale@icici"
UPI_PAYEE_NAME="Bawarchi Royale"
UPI_MERCHANT_CODE="5812"
PAYMENT_VERIFICATION_STRICT=true
# Optional Webhook Secret for ICICI / Paytm / PhonePe Soundbox notifications
PAYMENT_WEBHOOK_SECRET="whsec_prod_soundbox_verification_token_9941"

# ------------------------------------------------------------------------------
# HARDWARE THERMAL PRINTER CONFIGURATION
# ------------------------------------------------------------------------------
# Receipt Printer (58mm or 80mm ESC/POS)
RECEIPT_PRINTER_TYPE=80mm
RECEIPT_PRINTER_INTERFACE=NETWORK
RECEIPT_PRINTER_IP="192.168.1.200"
RECEIPT_PRINTER_PORT=9100

# Kitchen KOT Station Printers (ESC/POS Raw Sockets)
KOT_MAIN_KITCHEN_IP="192.168.1.201"
KOT_BAR_IP="192.168.1.202"
KOT_BAKERY_IP="192.168.1.203"
KOT_PRINTER_PORT=9100

# Cash Drawer RJ12 Kick Pulse
CASH_DRAWER_KICK_ON_CASH_SETTLE=true
CASH_DRAWER_PIN=PIN2

# ------------------------------------------------------------------------------
# AUDIT & SUPERVISOR OVERRIDE
# ------------------------------------------------------------------------------
SUPERVISOR_PIN_LENGTH=4
MAX_FAILED_PIN_ATTEMPTS=5
SESSION_EXPIRY_HOURS=12
