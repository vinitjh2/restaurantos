{
  "appId": "com.sutrauniverse.dinesutra",
  "appName": "DineSutra Restaurant OS",
  "webDir": "out",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "url": "http://localhost:3000"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "dinesutra"
    },
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#D97706"
    }
  }
}
